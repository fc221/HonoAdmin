{
  "name": "@hono-admin/server",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/app.ts",
    "./app": "./src/app.ts",
    "./api/routes": "./src/api/index.ts",
    "./api/openapi": "./src/api/openapi.ts",
    "./api/schema": "./src/api/schema.ts",
    "./migrations/*": "./src/migrations/*",
    "./service/*": "./src/service/*",
    "./utils/*": "./src/utils/*"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "build:bun": "bun build src/bun.ts --target=bun --outdir=dist",
    "build:node": "bun build src/node.ts --target=node --define=__APP_RUNTIME_TARGET__=\"node\" --outdir=dist",
    "build:workers": "bun build src/worker.ts --target=browser --outdir=dist/workers",
    "compile:bun": "bun run build:bun && bun build --compile --minify --sourcemap dist/bun.js --outfile dist/hono-admin"
  },
  "dependencies": {
    "@hono-admin/cache": "workspace:*",
    "@hono-admin/db": "workspace:*",
    "@hono-admin/file-storage": "workspace:*",
    "@hono-admin/runtime": "workspace:*",
    "@hono-admin/utils": "workspace:*",
    "@standard-community/standard-json": "^0.3.5",
    "@standard-community/standard-openapi": "^0.2.9",
    "hono": "^4.12.18",
    "hono-openapi": "^1.3.0",
    "openapi-types": "^12.1.3",
    "zod": "^4.4.2",
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.0",
    "@types/json-schema": "^7.0.15",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  }
}
