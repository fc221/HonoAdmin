{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node",
      "vite/client",
      "bun-types",
      "@cloudflare/workers-types"
    ],
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true
  },
  "references": [
    { "path": "./packages/utils" },
    { "path": "./packages/db" },
    { "path": "./packages/cache" },
    { "path": "./packages/file-storage" },
    { "path": "./packages/runtime" },
    { "path": "./apps/server" },
    { "path": "./apps/console" }
  ],
  "files": []
}
