{
  "name": "hono-admin",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:server": "cd apps/server && bun run dev",
    "dev:console": "cd apps/console && bun run dev",
    "dev:public": "cd apps/public && bun run dev",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "eslint apps packages tests scripts",
    "test": "bun test",
    "audit:structure": "bun run scripts/audit-agent-structure.ts",
    "check": "bun run typecheck && bun run lint && bun test && bun run build",
    "build": "bun run scripts/build.ts",
    "build:node": "bun run scripts/build.ts --target=node",
    "build:workers": "cd apps/server && bun run build:workers",
    "compile:bun": "bun run scripts/build.ts --compile",
    "preview": "wrangler dev --config wrangler.local.jsonc",
    "dev:worker": "bun run build:workers && wrangler dev --config wrangler.local.jsonc",
    "deploy": "bun run build:workers && wrangler deploy --config wrangler.local.jsonc"
  },
  "dependencies": {
    "@hono-admin/cache": "workspace:*",
    "@hono-admin/db": "workspace:*",
    "@hono-admin/file-storage": "workspace:*",
    "@hono-admin/runtime": "workspace:*",
    "@hono-admin/utils": "workspace:*",
    "@hono/node-server": "2.0.4",
    "@hono/standard-validator": "^0.2.2",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-validator": "^0.7.6",
    "@vitejs/plugin-vue": "^6.0.3",
    "astro": "^5.16.4",
    "dayjs": "^1.11.20",
    "hono": "^4.12.18",
    "hono-openapi": "^1.3.0",
    "ioredis": "5.11.1",
    "mysql2": "^3.22.4",
    "naive-ui": "^2.43.2",
    "pinia": "^3.0.4",
    "postgres": "^3.4.9",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3",
    "zod": "^4.4.2",
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@cloudflare/workers-types": "^4.20250214.0",
    "@tailwindcss/vite": "^4.0.9",
    "bun-types": "^1.3.13",
    "eslint": "^9.39.1",
    "eslint-plugin-format": "^2.0.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vue-tsc": "^3.1.6",
    "wrangler": "^4.4.0"
  }
}
