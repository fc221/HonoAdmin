{
  "name": "hono-admin",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:server": "cd apps/server && bun run dev",
    "dev:console": "cd apps/console && bun run dev",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "eslint apps packages tests scripts",
    "test": "bun test",
    "audit:structure": "bun run scripts/audit-agent-structure.ts",
    "check": "bun run typecheck && bun run lint && bun run audit:structure && bun test && bun run build",
    "build": "bun run scripts/build.ts",
    "build:node": "bun run scripts/build.ts --target=node",
    "build:workers": "cd apps/server && bun run build:workers",
    "compile:bun": "bun run scripts/build.ts --compile",
    "preview": "wrangler dev --config wrangler.local.jsonc",
    "dev:worker": "bun run build:workers && wrangler dev --config wrangler.local.jsonc",
    "deploy": "bun run build:workers && wrangler deploy --config wrangler.local.jsonc"
  },
  "dependencies": {
    "@hono-admin/cache": "workspace:*",
    "@hono-admin/db": "workspace:*",
    "@hono-admin/file-storage": "workspace:*",
    "@hono-admin/runtime": "workspace:*",
    "@hono-admin/utils": "workspace:*",
    "@hono/node-server": "2.0.4",
    "@hono/standard-validator": "^0.2.3",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-validator": "^0.7.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "dayjs": "^1.11.21",
    "hono": "^4.12.27",
    "hono-openapi": "^1.3.0",
    "ioredis": "5.11.1",
    "mysql2": "^3.22.5",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.4",
    "postgres": "^3.4.9",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4",
    "zod": "^4.4.3",
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "bun-types": "^1.3.14",
    "eslint": "^10.6.0",
    "eslint-plugin-format": "^2.0.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vue-tsc": "^3.3.6",
    "wrangler": "^4.107.0"
  }
}
